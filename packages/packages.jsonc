{
  // Local package supply layer for the AlionIT website.
  // See packages/README.md for the shared MyIdeas package standard.
  "schemaVersion": 1,
  "defaults": {
    "updateMode": "manual",
    "versionPolicy": "exact",
    "onMismatch": "fail",
    "exclude": [
      "node_modules/**",
      ".git/**",
      "temp-data/**",
      "_temp/**"
    ]
  },
  "packages": {}
}
