{
  "name": "@alionit/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AlionIT desktop Electron application.",
  "main": "main.js",
  "scripts": {
    "start": "npm run dev",
    "dev": "node ../scripts/dev-desktop.js",
    "dev:plain": "electron .",
    "check": "node ./scripts/check.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "prod:smoke": "npm run pack"
  },
  "build": {
    "appId": "com.alionit.desktop",
    "productName": "AlionIT Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "css/**/*",
      "img/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  }
}
